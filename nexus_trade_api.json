    {
      "name": "5. Transactions & Smart Escrow Vaults",
      "item": [
        {
          "name": "List Consignments & Escrows",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var results = jsonData.results || jsonData;",
                  "if (results.length > 0) {",
                  "    pm.collectionVariables.set('transaction_id', results[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/transactions/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "transactions", ""]
