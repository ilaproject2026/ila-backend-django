  "item": [
    {
      "name": "1. Authentication & Security Gate",
      "item": [
        {
          "name": "Login (Obtain JWT & Profile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access);",
                  "    console.log('Access token saved to collection variable.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login", ""]
            },
            "description": "Authenticates user and returns JWT access + refresh tokens and full user profile with roles."
          }
        },
        {
          "name": "Verify Security Gate PIN (7890 / ILA2026)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.elevated_token) {",
                  "    pm.collectionVariables.set('gate_token', jsonData.elevated_token);",
                  "    console.log('Gate token saved to collection variable.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin\": \"7890\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/verify-security-gate/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "verify-security-gate", ""]
            },
            "description": "Validates Level 1 Edit PIN ('7890' or 'ILA2026') and returns elevated security token valid for 15 minutes."
          }
        },
        {
          "name": "Get Current User Profile (/auth/me/)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
